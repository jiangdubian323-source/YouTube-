# YouTube Data API v3 の認証情報
# Google Cloud Console から取得した OAuth 2.0 クライアントID・シークレット
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Anthropic API キー
# https://console.anthropic.com から取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 対象のYouTubeチャンネルID（UCから始まる文字列）
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxx

# 1回の実行で処理するコメント数の上限（デフォルト: 10）
MAX_COMMENTS=10
