# YouTube Data API v3 の認証情報
# Google Cloud Console から取得した OAuth 2.0 クライアントID・シークレット
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Anthropic API キー
# https://console.anthropic.com から取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 対象のYouTubeチャンネルID（UCから始まる文字列）
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxx

# Cloud Run で使用する GCS バケット名（ローカル実行時は不要）
# token.json / last_run.json / instagram_token.json などをこのバケットに保存する
GCS_BUCKET_NAME=your-bucket-name

# ─────────────────────────────────────────
# Instagram コメント自動返信ツール用
# ─────────────────────────────────────────

# Facebook App の ID・シークレット
# https://developers.facebook.com/apps/ で取得
INSTAGRAM_APP_ID=your_app_id_here
INSTAGRAM_APP_SECRET=your_app_secret_here

# Instagram の短期アクセストークン（初回のみ設定）
# ツール実行時に自動で長期トークン（60日）に交換・GCS に保存される
INSTAGRAM_ACCESS_TOKEN=your_short_lived_token_here
