# YouTube Data API v3 の認証情報
# Google Cloud Console から取得した OAuth 2.0 クライアントID・シークレット
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Anthropic API キー
# https://console.anthropic.com から取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 対象のYouTubeチャンネルID（UCから始まる文字列）
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxx

# Cloud Run で使用する GCS バケット名（ローカル実行時は不要）
# token.json と last_run.json をこのバケットに保存する
GCS_BUCKET_NAME=your-bucket-name
